// ─────────────────────────────────────────────────────────────
// firestore.rules — กฎขั้นต่ำของสัปดาห์ที่ 7: "ต้องล็อกอินก่อน"
//
// ยังไม่แยกสิทธิ์ตาม role (employee/manager/hr) — กฎรายห้องแบบเต็ม
// จะทำในสัปดาห์ที่ 8 (ดู ACL.md และ leaveeasy-spec.md หัวข้อ 8)
//
// วิธี publish: คัดลอกไฟล์นี้ทั้งหมด → Firebase Console →
// Firestore Database → แท็บ Rules → วางทับของเดิม → กด Publish
// ─────────────────────────────────────────────────────────────

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
